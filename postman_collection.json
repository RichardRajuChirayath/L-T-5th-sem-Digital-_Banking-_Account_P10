    {
      "name": "Module 1: Customer Onboarding & KYC Capture",
      "item": [
        {
          "name": "POST Customer Registration (Onboarding + KYC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 409 (Already exists)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "var json = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Suresh Ramanathan\",\n  \"email\": \"suresh.ramanathan@customer.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"+91 9988112233\",\n  \"panNumber\": \"SURP1234K\",\n  \"aadhaarNumber\": \"887766554433\",\n  \"address\": \"12 Residency Road, Bangalore\",\n  \"occupation\": \"Tech Consultant\",\n  \"annualIncome\": 2100000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "POST Customer Login (Get Customer JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('customerToken', json.data.token);",
                  "pm.test('Customer JWT saved', function () {",
                  "    pm.expect(json.data.user.role).to.eql('CUSTOMER');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@customer.com\",\n  \"password\": \"Password@123\"\n}"
